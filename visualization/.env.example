# Visualization stack configuration
# Copy this file to .env and fill in the required secrets before running.

# CPU core(s) for telemetry containers (keeps them off real-time cores)
TELEM_CPU=0

# InfluxDB 2.x configuration
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=
INFLUXDB_ORG=rtdk
INFLUXDB_BUCKET=rtdk
INFLUXDB_TOKEN=

# Grafana admin credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=

# Port mappings (change if defaults conflict with your system)
MQTT_PORT=1883
MQTT_WS_PORT=9001
INFLUXDB_PORT=8086
GRAFANA_PORT=3000
